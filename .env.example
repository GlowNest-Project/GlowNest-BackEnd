PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3005
PUBLIC_API_ORIGIN=https://your-public-backend-domain.com
AUTH_SECRET=replace-with-a-long-random-secret

PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_FALLBACK_EMAIL=orders@example.com
PAYHERE_FALLBACK_CITY=Colombo

OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="GlowNest <your_email@gmail.com>"

# Notify.lk SMS Gateway Configuration
NOTIFYLK_USER_ID=your_user_id
NOTIFYLK_API_KEY=your_api_key
NOTIFYLK_SENDER_ID=NotifyDEMO

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glownest_db
DB_USER=glownest_app
DB_PASSWORD=your_database_password
